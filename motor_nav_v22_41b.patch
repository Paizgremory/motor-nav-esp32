+
+// v22.41b: blok RGB888 hasil decode -> LANGSUNG ke panel fisik (bypass kanvas sepenuhnya, 0 byte RAM tambahan).
+// Blok JPEG ROM (MCU) selalu <=16x16, jadi buffer statis kecil ini cukup.
+static UINT jdOutPanel(JDEC *jd, void *bmp, JRECT *r) {
+  (void)jd;
+  static uint16_t blk[16 * 16];
+  int w = r->right - r->left + 1, h = r->bottom - r->top + 1;
+  if (w > 16 || h > 16 || w <= 0 || h <= 0) return 0;
+  const uint8_t *p = (const uint8_t *)bmp;
+  for (int i = 0; i < w * h; i++, p += 3)
+    blk[i] = ((p[0] & 0xF8) << 8) | ((p[1] & 0xFC) << 3) | (p[2] >> 3);
+  panel->draw16bitRGBBitmap(r->left, r->top, blk, w, h);
+  return 1;
+}
+
+// v22.41b: khusus halaman peta dari aplikasi (appNavOn, HP sudah gambar seluruh layar + panah + banner).
+// TIDAK butuh kanvas (fb) sama sekali -> peta tetap bisa muncul walau kanvas 115 KB gagal/sedang dipakai wajah/standby/game.
+bool mapDecodeDirect(const uint8_t *p, uint32_t len) {
+  if (!jdPool || !p || len < 100) return false;
+  jdSrc = p; jdLen = len; jdPos = 0;
+  JDEC jd;
+  JRESULT rc = jd_prepare(&jd, jdIn, jdPool, JD_POOL, nullptr);
+  if (rc == JDR_OK && (jd.width != 240 || jd.height != 240)) rc = JDR_PAR;
+  if (rc == JDR_OK) rc = jd_decomp(&jd, jdOutPanel, 0);
+  return rc == JDR_OK;
+}
